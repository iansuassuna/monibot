{
  "name": "@monibot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/server.ts",
    "start": "bun --env-file=../../.env src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "test": "bun test",
    "test:e2e": "bun --env-file=../../.env scripts/e2e.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@monibot/auth": "workspace:*",
    "@monibot/db": "workspace:*",
    "@monibot/logger": "workspace:*",
    "@monibot/types": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "livekit-server-sdk": "2.19.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@monibot/tsconfig": "workspace:*"
  }
}
