{
  "name": "@monibot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run next dev --port 3000",
    "build": "bun --env-file=../../.env run next build",
    "start": "bun --env-file=../../.env run next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "lint": "biome check --write .",
    "lint:check": "biome check ."
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "@monibot/auth": "workspace:*",
    "@monibot/logger": "workspace:*",
    "@monibot/types": "workspace:*",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tanstack/react-query": "5.104.3",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "livekit-client": "2.23.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@monibot/api": "workspace:*",
    "@monibot/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
