# Runtime (NODE_ENV is set by each tool: `next build` needs production, `next dev` development)
LOG_LEVEL=debug

# PostgreSQL 16 + pgvector
DATABASE_URL=postgres://monibot:monibot@localhost:5432/monibot

# Better Auth (shared by apps/api and apps/web)
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
# Browser-facing origin: apps/web proxies /api/* to apps/api, so auth cookies are first-party.
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# API
API_PORT=3001
# Where apps/web reaches apps/api server-side (rewrites + RSC session checks).
API_INTERNAL_URL=http://localhost:3001

# Internal worker authentication (x-agent-secret)
AGENT_SECRET=change-me-at-least-16-chars

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Multilingual: v1 `nomic-embed-text` misranks Portuguese queries. Changing it requires re-indexing.
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
# Default LLM for new sessions (a session can override it). llama3.2:3b fits a 4 GB GPU.
OLLAMA_LLM_MODEL=llama3.1:8b
# Keep the embedder on the CPU when the GPU can't hold both models (e.g. 4 GB VRAM).
# OLLAMA_EMBED_NUM_GPU=0

# LiveKit SFU
LIVEKIT_URL=ws://localhost:7880
# Browser-facing LiveKit URL when it differs from LIVEKIT_URL (e.g. API in a container)
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=monibot

# Matrix (Synapse + Element Call)
# 127.0.0.1, not localhost: under rootless Podman `localhost` resolves to ::1 and the connection resets.
MATRIX_HOMESERVER_URL=http://127.0.0.1:8008
# Application-service token Synapse expects from MoniBot (the hs_token is MATRIX_WEBHOOK_SECRET)
MATRIX_AS_TOKEN=change-me-at-least-16-chars
MATRIX_WEBHOOK_SECRET=change-me-at-least-16-chars

# Voice pipeline (agent-worker): speaches serves faster-whisper STT and Piper TTS (OpenAI-compatible)
SPEACHES_BASE_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=pt
TTS_MODEL=speaches-ai/piper-pt_BR-faber-medium
